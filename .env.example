# Configuration for x-threaded. Every value is per-deployment: nothing here
# is baked into the code or committed to the repo.
#
#   Local dev (Bun server):  cp .env.example .env and fill this in.
#   Cloudflare Worker:       set the same names with `wrangler secret put NAME`
#                            (secrets persist across deploys; wrangler.jsonc
#                            vars would be committed and follow forks).
#
# Only X_BEARER_TOKEN is required. Everything else adds a feature, and the app
# degrades cleanly without it.

# ---- Required ----------------------------------------------------------

# App-only bearer token from https://developer.x.com — reads public
# conversations. Billed per post read (~$0.005); set a spending limit in the
# developer console.
X_BEARER_TOKEN=

# ---- Optional: user-context features -----------------------------------

# OAuth 2.0 credentials from the same X app, with "Type of App" set to
# confidential client. Enables the Your posts tab and bookmark folder sync.
# Register these callbacks on the app:
#   http://localhost:8788/auth/callback     (local dev)
#   https://<your-worker>/auth/callback     (deployed)
# Then visit /auth/login once per deployment to authorize. Each deployment
# holds its own token chain — never copy tokens between them, since refresh
# tokens are single-use and rotate, so two copies invalidate each other.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# ---- Optional: Cloudflare Access enforcement (deployed only) -----------

# Set these only if the Worker sits behind Cloudflare Access. When present,
# the Worker verifies the Access JWT on every /api request, so the API fails
# closed if Access is ever turned off. Both values appear in the modal shown
# when you enable Access. Leave unset to run without a gate.
# POLICY_AUD=
# TEAM_DOMAIN=https://<your-team>.cloudflareaccess.com

# ---- Optional: local server tuning -------------------------------------

# Port for the Bun dev server; must match the registered OAuth callback.
PORT=8788

# SQLite file for local dev (the Worker uses D1 instead).
DB_PATH=data/x-threaded.sqlite

# Safety cap on posts fetched per conversation load. 500 posts ≈ $2.50 worst
# case; the fetch stops and reports truncation beyond this.
MAX_POSTS_PER_FETCH=500
