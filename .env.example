# Configuration for x-threaded. Every value is per-deployment: nothing here
# is baked into the code or committed to the repo.
#
#   Local dev:  cp .env.example .env and fill this in. Both local runtimes
#               read it — the Bun server natively, and `wrangler dev` too.
#               (Don't create a .dev.vars file: wrangler silently ignores
#               .env when one exists.)
#   Deployed:   set the same names with `wrangler secret put NAME`. Secrets
#               persist across deploys; wrangler.jsonc vars would be
#               committed and follow anyone who forks the repo.
#
# Only X_BEARER_TOKEN is required. Everything else adds a feature, and the app
# degrades cleanly without it.

# ---- Required ----------------------------------------------------------

# App-only bearer token from https://developer.x.com — reads public
# conversations. Billed per post read (~$0.005); set a spending limit in the
# developer console.
X_BEARER_TOKEN=

# ---- Optional: user-context features -----------------------------------

# OAuth 2.0 credentials from an X app with "Type of App" set to confidential
# client. Enables the Your posts tab and bookmark folder sync. Register the
# callback for THIS deployment on the app:
#   http://localhost:8788/auth/callback     (local dev)
#   https://<your-worker>/auth/callback     (deployed)
# Then visit /auth/login once to authorize it.
#
# Give every deployment its OWN X app (a developer account allows 3). X keeps
# at most one live grant per user per client id, so authorizing a second
# deployment through the same app SILENTLY revokes the first one's tokens —
# production quietly logs itself out the next time you run local dev. Never
# copy tokens between deployments either: refresh tokens are single-use and
# rotate, so two holders of one chain invalidate each other. Both rules and
# the evidence behind them: docs/x-api-notes.md N14, N15.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# ---- Optional: Cloudflare Access enforcement (deployed only) -----------

# Set these only if the Worker sits behind Cloudflare Access. When present,
# the Worker verifies the Access JWT on every request that reaches it — both
# /api/* and /auth/* — so the API fails closed if Access is ever turned off.
# Both values appear in the modal shown when you enable Access. Leave unset to
# run without a gate.
# POLICY_AUD=
# TEAM_DOMAIN=https://<your-team>.cloudflareaccess.com

# ---- Optional: local server tuning -------------------------------------

# Port for the Bun dev server; must match the registered OAuth callback.
PORT=8788

# Same, for scripts/dev-worker.sh (`wrangler dev`). Separate from PORT because
# the two runtimes are started by different things; they default to the same
# port, so only one may run at a time unless you change this.
WORKER_PORT=8788

# SQLite file for local dev (the Worker uses D1 instead).
DB_PATH=data/x-threaded.sqlite

# Safety cap on posts fetched per conversation load. 500 posts ≈ $2.50 worst
# case; the fetch stops and reports truncation beyond this.
MAX_POSTS_PER_FETCH=500
