# App-only bearer token for the X API (required).
# Local dev: leave unset and use `bun run dev:server`, which sources it from
# ~/.claude/secrets.env (1Password). Or paste a token here and copy to .env.
X_BEARER_TOKEN=

# Server port (default 8787)
PORT=8787

# SQLite database file (default data/x-threaded.sqlite)
DB_PATH=data/x-threaded.sqlite

# Safety cap on posts fetched per conversation load ($0.005/post read).
# 500 posts = $2.50 worst case. Fetch stops and reports truncation beyond this.
MAX_POSTS_PER_FETCH=500
